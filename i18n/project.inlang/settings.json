{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": ["zh-TW", "en"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@4.5.0/dist/index.js",
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-m-function-matcher@2.3.0/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}.json",
      "./messages/lobby/{locale}.json",
      "./messages/catalog/{locale}.json",
      "./messages/catalog/rooms/{locale}.json",
      "./messages/battle/{locale}.json"
    ]
  }
}
